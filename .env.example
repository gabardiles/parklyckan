# Kopiera till .env.local och fyll i värdena. .env* är gitignorerad.

# --- Databas (anmälningar sparas här) ---------------------------------
# Neon Postgres. Lägg till Neon under Vercel → projektet → Storage, så sätts
# DATABASE_URL automatiskt (använd den poolade, -pooler i värdnamnet).
# Tabellen skapas automatiskt vid första anmälan.
# Lokalt: postgres://<user>@localhost:5432/parklyckan
DATABASE_URL=

# --- Admin (/admin) ----------------------------------------------------
# Lösenord för admin-sidan, minst 10 tecken. Byte loggar ut alla sessioner.
ADMIN_PASSWORD=

# --- Mejlnotiser via Resend --------------------------------------------
# https://resend.com/api-keys
RESEND_API_KEY=

# Avsändare på en domän som är verifierad i Resend-kontot.
INTEREST_FORM_FROM="Parklyckan <no-reply@polarweb.se>"

# Valfri. Ersätter standardmottagarna (kommaseparerad lista).
# Utan den mejlas produktion till mäklaren enligt SITE.interestForm i
# lib/seo.ts, medan preview och lokalt inte mejlar alls.
# Sätt den lokalt så att tester inte når mäklaren.
INTEREST_NOTIFICATION_TO=
